    <!-- Bottom bar: Clients + Privacy -->
    <div class="border-border/30 mt-10 flex flex-col items-center justify-between gap-6 border-t pt-8 sm:flex-row">
      <!-- Supported clients -->
      <div class="flex flex-wrap items-center justify-center gap-3 sm:justify-start">
        <span class="text-muted-foreground text-xs font-medium uppercase tracking-wider">Works with</span>
        <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          <span class="border-border/50 bg-card inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium">
            Claude
          </span>
          <span class="border-border/50 bg-card inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium">
