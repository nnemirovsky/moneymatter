      </div>
      <div class="border-border/50 bg-background flex items-center gap-3 rounded-xl border px-4 py-3 md:w-[420px] md:shrink-0">
        <code id="mcp-endpoint" class="flex-1 overflow-x-auto font-mono text-sm whitespace-nowrap">https://mcp.moneymatter.app/mcp</code>
        <button
          id="mcp-copy-button"
          type="button"
          class="text-muted-foreground hover:bg-card hover:text-foreground inline-flex shrink-0 items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors"
          aria-label="Copy MCP server URL"
        >
          <!-- Copy -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mcp-copy-icon size-4"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <!-- Check -->
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mcp-check-icon hidden size-4 text-green-500"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="mcp-copy-label">Copy</span>
