<style>
  .mcp-receipt-edge {
    background:
      linear-gradient(135deg, #fafaf9 50%, transparent 50%) 0 0 / 12px 12px repeat-x,
      linear-gradient(225deg, #fafaf9 50%, transparent 50%) 0 0 / 12px 12px repeat-x;
  }

  @media (prefers-reduced-motion: no-preference) {
    .is-armed [data-anim] {
      opacity: 0;
    }
    .is-armed .is-playing [data-anim] {
      animation: mcp-rise 0.45s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms) both;
    }
    .is-armed .is-playing [data-bar] {
      animation: mcp-grow 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--d, 0ms) + 150ms) both;
    }
  }

  @keyframes mcp-rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mcp-grow {
    from {
      width: 0;
    }
  }
</style>

<script>
  const button = document.getElementById('mcp-copy-button');
  const endpoint = document.getElementById('mcp-endpoint');

  if (button && endpoint) {
    const copyIcon = button.querySelector('.mcp-copy-icon');
    const checkIcon = button.querySelector('.mcp-check-icon');
    const label = button.querySelector('.mcp-copy-label');
    let timeout: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(endpoint.textContent?.trim() ?? '');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      if (label) label.textContent = 'Copied';
      clearTimeout(timeout);
      timeout = setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (label) label.textContent = 'Copy';
      }, 2000);
    });
  }

  const demo = document.getElementById('mcp-demo');

  if (demo) {
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-scenario-tab]')];
    const panels = [...demo.querySelectorAll<HTMLElement>('[data-scenario]')];

    const show = ({ id }: { id: string }) => {
      tabs.forEach((tab) => tab.setAttribute('aria-pressed', String(tab.dataset.scenarioTab === id)));
      panels.forEach((panel) => {
        const isActive = panel.dataset.scenario === id;
        panel.hidden = !isActive;
        panel.classList.remove('is-playing');
        if (isActive) {
          // Force reflow so re-adding the class restarts the CSS animations.
          void panel.offsetWidth;
          panel.classList.add('is-playing');
        }
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0]?.isIntersecting) return;
        observer.disconnect();
        show({ id: tabs[0]!.dataset.scenarioTab! });
      },
      { threshold: 0.3 },
    );

    const SCROLL_DURATION_MS = 250;
    const mobileQuery = window.matchMedia('(max-width: 767px)');
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Native smooth scroll has no speed control and is too slow to land before the animations start.
    const scrollToPanelStart = ({ id }: { id: string }) => {
      const panel = panels.find((item) => item.dataset.scenario === id);
      if (!panel) return;

      const headerHeight = document.querySelector('header')?.offsetHeight ?? 0;
      const from = window.scrollY;
      const to = from + panel.getBoundingClientRect().top - headerHeight - 16;

      if (reducedMotionQuery.matches) {
        window.scrollTo(0, to);
        return;
      }

      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / SCROLL_DURATION_MS, 1);
        const eased = 1 - (1 - progress) ** 3;
        window.scrollTo(0, from + (to - from) * eased);
        if (progress < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        const id = tab.dataset.scenarioTab!;
        observer.disconnect();
        show({ id });
        if (mobileQuery.matches) scrollToPanelStart({ id });
      }),
    );

    demo.classList.add('is-armed');
    observer.observe(demo);
  }
</script>
