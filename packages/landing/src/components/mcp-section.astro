---
type Category = 'Groceries' | 'Transport' | 'Subscriptions' | 'Income' | 'Dining';

interface Txn {
  date: string;
  payee: string;
  category: Category;
  amount: number;
}

interface QuestionRow {
  label: string;
  sub: string;
  value: string;
  bar?: number;
  over?: boolean;
}

const CATEGORY_CLASS: Record<Category, string> = {
  Groceries: 'bg-green-500/10 text-green-400',
  Transport: 'bg-sky-500/10 text-sky-400',
  Subscriptions: 'bg-purple-500/10 text-purple-300',
  Income: 'bg-amber-500/10 text-amber-400',
  Dining: 'bg-rose-500/10 text-rose-400',
};

const TXNS: Txn[] = [
  { date: 'Oct 02', payee: 'Whole Foods', category: 'Groceries', amount: -38.4 },
  { date: 'Oct 03', payee: 'Shell', category: 'Transport', amount: -52.1 },
  { date: 'Oct 05', payee: 'Spotify', category: 'Subscriptions', amount: -11.99 },
  { date: 'Oct 06', payee: 'Acme Corp Payroll', category: 'Income', amount: 2600 },
  { date: 'Oct 08', payee: 'Chipotle', category: 'Dining', amount: -24.5 },
  { date: 'Oct 09', payee: "Trader Joe's", category: 'Groceries', amount: -61.2 },
];

const RECEIPT_ITEMS = [
  ['Whole milk 1gal', '4.29'],
  ['Sourdough bread', '3.49'],
  ['Free-range eggs', '1.19'],
  ['Bananas 2lb', '0.85'],
  ['Cheddar 8oz', '1.79'],
];

const SOURCES = [
  {
    id: 'pdf',
    icon: '📄',
    label: 'Bank statement PDF',
    prompt: 'Add every transaction from this statement to my checking account.',
    txns: TXNS,
    answer: 'Imported 6 transactions to Checking: $2,600.00 in income and $188.19 in expenses.',
  },
  {
    id: 'csv',
    icon: '📊',
    label: 'CSV / spreadsheet',
    prompt: "Here's an export from my old app. Import all of it to checking.",
    txns: TXNS.filter((txn) => txn.payee !== 'Spotify'),
    answer: 'Imported all 5 rows to Checking, each matched to a category and payee.',
  },
  {
    id: 'receipt',
    icon: '🧾',
    label: 'Receipt photo',
    prompt: 'Add this receipt to my expenses.',
    txns: [{ date: 'Oct 08', payee: "Trader Joe's", category: 'Groceries', amount: -11.61 }] as Txn[],
    answer: "Added one $11.61 expense at Trader Joe's, categorized automatically.",
  },
  {
    id: 'screenshot',
    icon: '📱',
    label: 'Screenshot',
    prompt: 'Add the transactions from this screenshot to checking.',
    txns: TXNS.slice(0, 5),
    answer: 'Imported 5 transactions to Checking, categorized automatically.',
  },
];

const QUESTIONS: { id: string; label: string; tool: string; prompt: string; rows: QuestionRow[]; answer: string }[] = [
  {
    id: 'subscriptions',
    label: 'Price hikes?',
    tool: 'get_subscriptions',
    prompt: 'Which of my subscriptions got more expensive this year?',
    rows: [
      { label: 'Netflix', sub: 'January · $15.49 → $19.49', value: '+$4.00' },
      { label: 'iCloud', sub: 'March · $2.99 → $3.99', value: '+$1.00' },
      { label: 'Spotify', sub: 'June · $9.99 → $11.99', value: '+$2.00' },
    ],
    answer:
      'Three did: <strong class="font-medium">Netflix</strong> +$4.00 in January, <strong class="font-medium">iCloud</strong> +$1.00 in March, <strong class="font-medium">Spotify</strong> +$2.00 in June. Combined that adds <strong class="font-medium">$84/year</strong>.',
  },
  {
    id: 'categories',
    label: 'By category',
    tool: 'get_spending_by_categories',
    prompt: 'Where did my money go last month?',
    rows: [
      { label: 'Groceries', sub: '42 transactions', value: '$612.30', bar: 100 },
      { label: 'Dining', sub: '18 transactions', value: '$388.10', bar: 63 },
      { label: 'Transport', sub: '11 transactions', value: '$295.40', bar: 48 },
      { label: 'Shopping', sub: '7 transactions', value: '$241.00', bar: 39 },
      { label: 'Subscriptions', sub: '6 transactions', value: '$96.40', bar: 16 },
    ],
    answer:
      'Groceries led at <strong class="font-medium">$612</strong>, over a third of the month. Dining came second and is <strong class="font-medium">up 40%</strong> on the month before.',
  },
  {
    id: 'budget',
    label: 'Over budget?',
    tool: 'get_tracker_spending_stats',
    prompt: 'Am I over budget on anything this month?',
    rows: [
      { label: 'Dining', sub: '$548 of $500', value: '110%', bar: 110, over: true },
      { label: 'Groceries', sub: '$640 of $800', value: '80%', bar: 80 },
      { label: 'Transport', sub: '$180 of $300', value: '60%', bar: 60 },
      { label: 'Entertainment', sub: '$95 of $200', value: '48%', bar: 48 },
    ],
    answer:
      'Only <strong class="font-medium">Dining</strong>: $48 over with 9 days to go. Everything else is on track, and Groceries still has $160 left.',
  },
];

const AUTOMATIONS = [
  {
    title: 'Weekly digest',
    trigger: 'Every Monday, 8:00',
    tool: 'get_expenses_for_period',
    message:
      'You spent <strong class="font-medium">$412</strong> last week, 12% less than usual. Groceries took the most at $148.',
  },
  {
    title: 'Anomaly check',
    trigger: 'Every day, 21:00',
    tool: 'search_transactions',
    message:
      '<strong class="font-medium">$249.00 at Best Buy</strong> is 4× your usual Shopping spend. Was that you?',
  },
  {
    title: 'Budget health check',
    trigger: '1st of every month',
    tool: 'get_tracker_spending_stats',
    message:
      '3 of 4 budgets stayed on track in September. Trimming Dining by <strong class="font-medium">$50/month</strong> gets you to your savings goal by December.',
  },
];

const ROW_START_MS = 450;
const ROW_STEP_MS = 160;
const rowDelay = ({ index }: { index: number }) => `--d:${ROW_START_MS + index * ROW_STEP_MS}ms`;
const answerDelay = ({ rows }: { rows: number }) => `--d:${ROW_START_MS + rows * ROW_STEP_MS + 250}ms`;

const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
const formatAmount = ({ amount }: { amount: number }) => `${amount > 0 ? '+' : '−'}${usd.format(Math.abs(amount))}`;

const tabBase =
  'inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors sm:text-sm aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground';
---

<section class="relative z-10 py-16 sm:py-24">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto max-w-2xl text-center">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-purple-500/20 bg-purple-500/10 px-3 py-1 text-sm text-purple-400"
      >
        <!-- Sparkles -->
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
        New
      </div>
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Your finances, AI-ready</h2>
      <p class="text-muted-foreground mt-4 text-lg">
        Connect Claude, ChatGPT, or any MCP-compatible AI to your financial data. Hand it a statement, a spreadsheet, or a
        receipt photo and it books the transactions. Ask questions the UI can't answer.
      </p>
    </div>

    <!-- Agent session demo -->
    <div
      id="mcp-demo"
      class="border-border/60 bg-card mx-auto mt-12 max-w-5xl overflow-hidden rounded-2xl border shadow-2xl shadow-purple-500/5"
    >
      <div class="border-border/50 bg-background/40 flex items-center gap-2 border-b px-4 py-3">
        <span class="size-3 rounded-full bg-red-500/80"></span>
        <span class="size-3 rounded-full bg-yellow-500/80"></span>
        <span class="size-3 rounded-full bg-green-500/80"></span>
        <span class="text-muted-foreground ml-2 text-sm">MoneyMatter MCP · agent session</span>
      </div>

      <div class="p-4 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          {
            SOURCES.map((source, index) => (
              <button
                type="button"
                data-scenario-tab={source.id}
                aria-pressed={index === 0 ? 'true' : 'false'}
                class:list={[tabBase, 'border-border bg-background/60 hover:border-purple-500/40']}
              >
                <span aria-hidden="true">{source.icon}</span>
                {source.label}
              </button>
            ))
          }
          <span class="bg-border mx-1 hidden h-6 w-px sm:block"></span>
          {
            QUESTIONS.map((question) => (
              <button
                type="button"
                data-scenario-tab={question.id}
                aria-pressed="false"
                class:list={[tabBase, 'border-border border-dashed hover:border-purple-500/40']}
              >
                <span aria-hidden="true">💬</span>
                {question.label}
              </button>
            ))
          }
          <span class="bg-border mx-1 hidden h-6 w-px sm:block"></span>
          <button
            type="button"
            data-scenario-tab="automations"
            aria-pressed="false"
            class:list={[tabBase, 'border-dashed border-cyan-500/30 hover:border-cyan-500/60']}
          >
            <span aria-hidden="true">⏰</span>
            On a schedule
          </button>
        </div>

        <div class="mt-6">
          {
            SOURCES.map((source, index) => (
              <div data-scenario={source.id} hidden={index !== 0}>
                <div class="flex flex-col gap-4">
                  <p
                    data-anim
                    class="ml-auto max-w-[90%] rounded-xl rounded-br-sm border border-purple-500/20 bg-purple-500/10 px-4 py-3 text-sm leading-relaxed"
                  >
                    {source.prompt}
                  </p>

                  <div class="grid grid-cols-[minmax(0,1fr)] gap-3 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]">
                    <div
                      data-anim
                      style="--d:150ms"
                      class="border-border/50 bg-background/60 flex items-start justify-center rounded-xl border p-4 md:min-h-[380px]"
                    >
                      {source.id === 'pdf' && (
                        <div class="w-full rounded-lg bg-white p-4 text-xs text-stone-800 shadow-lg">
                          <div class="flex items-start justify-between gap-3 border-b border-stone-200 pb-3">
                            <div class="flex items-center gap-2.5">
                              <span class="flex size-8 items-center justify-center rounded-md bg-emerald-700 text-sm font-bold text-white">
                                F
                              </span>
                              <div>
                                <p class="text-sm font-semibold">First Federal</p>
                                <p class="text-[10px] text-stone-500">Account statement</p>
                              </div>
                            </div>
                            <p class="text-right text-[10px] leading-relaxed text-stone-500">
                              Acct ····4821
                              <br />
                              Oct 1–31, 2026
                            </p>
                          </div>
                          <table class="mt-2 w-full">
                            <thead>
                              <tr class="text-[9px] tracking-wider text-stone-400 uppercase">
                                <th class="py-1.5 text-left font-medium">Date</th>
                                <th class="py-1.5 text-left font-medium">Description</th>
                                <th class="py-1.5 text-right font-medium">Amount</th>
                              </tr>
                            </thead>
                            <tbody>
                              {source.txns.map((txn) => (
                                <tr class="border-t border-stone-100">
                                  <td class="py-1.5 whitespace-nowrap">{txn.date}</td>
                                  <td class="py-1.5">{txn.payee}</td>
                                  <td class:list={['py-1.5 text-right tabular-nums', txn.amount > 0 && 'text-emerald-600']}>
                                    {formatAmount({ amount: txn.amount })}
                                  </td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                          <div class="mt-3 flex justify-between border-t border-stone-200 pt-2 font-semibold">
                            <span>Closing balance</span>
                            <span class="tabular-nums">$3,182.41</span>
                          </div>
                        </div>
                      )}

                      {source.id === 'csv' && (
                        <div class="border-border w-full min-w-0 overflow-hidden rounded-lg border bg-zinc-950 font-mono text-xs">
                          <div class="border-border text-muted-foreground flex items-center gap-2 border-b px-3 py-2">
                            <span class="size-2 rounded-full bg-green-500" />
                            export.csv
                          </div>
                          <div class="overflow-x-auto">
                            <table class="w-full">
                              <thead class="text-foreground">
                                <tr>
                                  {['date', 'payee', 'category', 'amount'].map((heading) => (
                                    <th class="border-border border-r px-2.5 py-1.5 text-left font-semibold last:border-r-0 last:text-right">
                                      {heading}
                                    </th>
                                  ))}
                                </tr>
                              </thead>
                              <tbody class="text-muted-foreground">
                                {source.txns.map((txn) => (
                                  <tr class="border-border border-t">
                                    <td class="border-border border-r px-2.5 py-1.5 whitespace-nowrap">{txn.date}</td>
                                    <td class="border-border text-foreground border-r px-2.5 py-1.5 whitespace-nowrap">
                                      {txn.payee}
                                    </td>
                                    <td class="border-border border-r px-2.5 py-1.5">{txn.category}</td>
                                    <td class:list={['px-2.5 py-1.5 text-right', txn.amount > 0 && 'text-green-400']}>
                                      {txn.amount.toFixed(2)}
                                    </td>
                                  </tr>
                                ))}
                              </tbody>
                            </table>
                          </div>
                        </div>
                      )}

                      {source.id === 'receipt' && (
                        <div class="w-60 font-mono text-xs text-stone-800 drop-shadow-lg">
                          <div class="bg-stone-50 px-5 pt-5 pb-3">
                            <p class="text-center text-base font-bold tracking-[0.3em]">TRADER JOE'S</p>
                            <p class="mt-1 text-center text-[10px] text-stone-500">Brooklyn · Oct 08 2026 14:32</p>
                            <div class="my-3 border-t border-dashed border-stone-300" />
                            {RECEIPT_ITEMS.map(([item, price]) => (
                              <p class="flex justify-between py-0.5">
                                <span>{item}</span>
                                <span>${price}</span>
                              </p>
                            ))}
                            <div class="my-3 border-t border-dashed border-stone-300" />
                            <p class="flex justify-between font-bold">
                              <span>TOTAL</span>
                              <span>$11.61</span>
                            </p>
                            <p class="mt-2 flex justify-between text-[10px] text-stone-500">
                              <span>VISA ····4821</span>
                              <span>Approved</span>
                            </p>
                            <p class="mt-3 text-center text-[10px] text-stone-500">Thank you!</p>
                          </div>
                          <div class="mcp-receipt-edge h-3" />
                        </div>
                      )}

                      {source.id === 'screenshot' && (
                        <div class="w-56 rounded-[2rem] border-[6px] border-zinc-800 bg-zinc-800 shadow-xl">
                          <div class="mx-auto my-1.5 h-1.5 w-16 rounded-full bg-zinc-600" />
                          <div class="overflow-hidden rounded-[1.5rem] bg-white text-zinc-900">
                            <div class="bg-primary px-4 py-3 text-white">
                              <p class="text-[10px] tracking-wider uppercase opacity-80">Checking · ····4821</p>
                              <p class="text-xl font-bold tabular-nums">$3,182.41</p>
                            </div>
                            {source.txns.map((txn) => (
                              <div class="flex items-center gap-2.5 border-t border-zinc-100 px-3 py-2">
                                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-zinc-100 text-[11px] font-semibold text-zinc-500">
                                  {txn.payee[0]}
                                </span>
                                <div class="min-w-0 flex-1">
                                  <p class="truncate text-xs font-medium">{txn.payee}</p>
                                  <p class="text-[10px] text-zinc-400">{txn.date}</p>
                                </div>
                                <span class:list={['text-xs font-semibold tabular-nums', txn.amount > 0 && 'text-green-600']}>
                                  {formatAmount({ amount: txn.amount })}
                                </span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>

                    <div data-anim style="--d:300ms" class="text-primary-text flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 rotate-90 md:rotate-0"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </div>

                    <div data-anim style="--d:350ms" class="border-border/50 bg-background/60 overflow-hidden rounded-xl border md:min-h-[380px]">
                      <div class="border-border/50 flex items-center justify-between border-b px-4 py-2.5">
                        <span class="flex items-center gap-2 font-mono text-xs text-green-400">
                          <span class="size-1.5 animate-pulse rounded-full bg-green-500" />
                          create_transaction
                        </span>
                        <span class="text-muted-foreground text-xs">MoneyMatter</span>
                      </div>
                      <ul class="px-4">
                        {source.txns.map((txn, rowIndex) => (
                          <li
                            data-anim
                            style={rowDelay({ index: rowIndex })}
                            class="border-border/40 flex items-center justify-between gap-3 border-b py-2.5 last:border-b-0"
                          >
                            <div class="min-w-0">
                              <p class="truncate text-sm font-medium">{txn.payee}</p>
                              <div class="mt-1 flex items-center gap-2">
                                <span class:list={['rounded-full px-2 py-0.5 text-[11px] font-medium', CATEGORY_CLASS[txn.category]]}>
                                  {txn.category}
                                </span>
                                <span class="text-muted-foreground text-xs">{txn.date}</span>
                              </div>
                            </div>
                            <span class:list={['shrink-0 text-sm font-semibold tabular-nums', txn.amount > 0 && 'text-green-400']}>
                              {formatAmount({ amount: txn.amount })}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <p
                    data-anim
                    style={answerDelay({ rows: source.txns.length })}
                    class="max-w-[90%] rounded-xl rounded-bl-sm border border-green-500/20 bg-green-500/[0.06] px-4 py-3 text-sm leading-relaxed text-green-100"
                  >
                    {source.answer}
                  </p>
                </div>
              </div>
            ))
          }

          {
            QUESTIONS.map((question) => (
              <div data-scenario={question.id} hidden>
                <div class="flex flex-col gap-4">
                  <p
                    data-anim
                    class="ml-auto max-w-[90%] rounded-xl rounded-br-sm border border-purple-500/20 bg-purple-500/10 px-4 py-3 text-sm leading-relaxed"
                  >
                    {question.prompt}
                  </p>

                  <div data-anim style="--d:250ms" class="border-border/50 bg-background/60 overflow-hidden rounded-xl border md:min-h-[380px]">
                    <div class="border-border/50 flex items-center justify-between border-b px-4 py-2.5">
                      <span class="flex items-center gap-2 font-mono text-xs text-green-400">
                        <span class="size-1.5 animate-pulse rounded-full bg-green-500" />
                        {question.tool}
                      </span>
                      <span class="text-muted-foreground text-xs">MoneyMatter</span>
                    </div>
                    <ul class="px-4">
                      {question.rows.map((row, rowIndex) => (
                        <li data-anim style={rowDelay({ index: rowIndex })} class="border-border/40 border-b py-3 last:border-b-0">
                          <div class="flex items-baseline justify-between gap-3">
                            <div class="min-w-0">
                              <p class="truncate text-sm font-medium">{row.label}</p>
                              <p class="text-muted-foreground text-xs">{row.sub}</p>
                            </div>
                            <span class:list={['shrink-0 text-sm font-semibold tabular-nums', row.over && 'text-rose-400']}>
                              {row.value}
                            </span>
                          </div>
                          {row.bar !== undefined && (
                            <div class="bg-muted mt-2 h-1.5 overflow-hidden rounded-full">
                              <div
                                data-bar
                                class:list={['h-full rounded-full', row.over ? 'bg-rose-500' : 'bg-primary']}
                                style={`width:${Math.min(row.bar, 100)}%`}
                              />
                            </div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <p
                    data-anim
                    style={answerDelay({ rows: question.rows.length })}
                    class="max-w-[90%] rounded-xl rounded-bl-sm border border-green-500/20 bg-green-500/[0.06] px-4 py-3 text-sm leading-relaxed text-green-100"
                    set:html={question.answer}
                  />
                </div>
              </div>
            ))
          }

          <div data-scenario="automations" hidden>
            <div class="flex flex-col gap-5">
              <p data-anim class="text-muted-foreground text-center text-sm">
                Use OpenClaw, Claude, or any agent framework to run financial analyses on a schedule you set.
              </p>
              {
                AUTOMATIONS.map((automation, index) => (
                  <div data-anim style={`--d:${300 + index * 600}ms`} class="flex flex-col gap-2">
                    <span class="inline-flex items-center gap-1.5 self-center rounded-full border border-cyan-500/20 bg-cyan-500/10 px-3 py-1 text-xs text-cyan-400">
                      <span aria-hidden="true">⏰</span>
                      {automation.title} · {automation.trigger}
                    </span>
                    <div class="border-border/50 bg-background/60 max-w-[90%] rounded-xl rounded-bl-sm border px-4 py-3">
                      <span class="flex items-center gap-2 font-mono text-xs text-green-400">
                        <span class="size-1.5 rounded-full bg-green-500" />
                        {automation.tool}
                      </span>
                      <p class="mt-1.5 text-sm leading-relaxed" set:html={automation.message} />
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Connect -->
    <div class="border-border/50 bg-card mx-auto mt-8 flex max-w-5xl flex-col gap-5 rounded-2xl border p-6 sm:p-8 md:flex-row md:items-center md:justify-between">
      <div class="flex items-start gap-3 md:max-w-md">
        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-500/10">
          <!-- Plug -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-purple-500"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"/></svg>
